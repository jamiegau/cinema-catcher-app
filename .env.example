# IANA timezone name used by the application and scheduled jobs.
LOCAL_TIMEZONE_NAME=Australia/Melbourne

# Unique name for this Catcher server, for example chain-site-catcher.
CATCHER_HOSTNAME=example-site-catcher

# Static address of this server's interface on the projection network.
EXPOSED_IP_PROJECTION_NETWORK=192.168.10.10

# Set False only while diagnosing a development installation.
IN_PRODUCTION=True

# Optional. NetBird is disabled by default; set a setup key and use
# `docker compose --profile netbird up -d` if remote NetBird access is wanted.
NB_SETUP_KEY=
